<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="rim.urdf.xacro"/>

    <xacro:property name="base_lenght" value="0.28"/>
    <xacro:property name="base_width" value="0.25"/>
    <xacro:property name="base_height" value="0.115"/>
    <xacro:property name="wheel_radius" value="0.029"/>
    <xacro:property name="wheel_length" value="0.025"/>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_lenght} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_lenght} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
       </collision> 
        <xacro:box_inertia m="5.0" x="${base_lenght}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0" />
    </link>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <xacro:rim_macro
        name="right_back"
        color="0.3 0 0"
        xyz="${-base_lenght / 2.5} ${-(base_width+wheel_length)/2.0} 0"
        rpy="1.570796326794896 0 3.14159265359"
    />
    <xacro:rim_macro
        name="left_back"
        color="0 0.3 0"
        xyz="${-base_lenght / 2.5} ${(base_width+wheel_length)/2.0} 0"
        rpy="1.570796326794896 0 0"
    />
    <xacro:rim_macro
        name="right_front"
        color="0 0 0.3"
        xyz="${base_lenght / 2.5} ${-(base_width+wheel_length)/2.0} 0"
        rpy="1.570796326794896 0 3.14159265359"
    />
    
        <xacro:rim_macro
            name="left_front"
            color="0.3 0.3 0.3"
            xyz="${base_lenght / 2.5} ${(base_width+wheel_length)/2.0} 0"
            rpy="1.570796326794896 0 0"
        />
        
    </robot>