<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Wheel surface friction is configured inside mecanum_wheel.urdf.xacro using fdir1 -->

    <xacro:macro name="joint_ctrl" params="joint_name topic">
        <gazebo>
            <plugin
                filename="gz-sim-joint-controller-system"
                name="gz::sim::systems::JointController">
                <joint_name>${joint_name}</joint_name>
                <topic>${topic}</topic>
            </plugin>
        </gazebo>
    </xacro:macro>

    <xacro:joint_ctrl joint_name="base_left_front_wheel_joint" topic="/base_left_front_wheel_joint/cmd_vel"/>
    <xacro:joint_ctrl joint_name="base_right_front_wheel_joint" topic="/base_right_front_wheel_joint/cmd_vel"/>
    <xacro:joint_ctrl joint_name="base_left_back_wheel_joint" topic="/base_left_back_wheel_joint/cmd_vel"/>
    <xacro:joint_ctrl joint_name="base_right_back_wheel_joint" topic="/base_right_back_wheel_joint/cmd_vel"/>
      
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <robot_namespace>my_robot</robot_namespace>
            <model_name>my_robot</model_name>
            <joint_name>base_left_back_wheel_joint</joint_name>
            <joint_name>base_right_back_wheel_joint</joint_name>
            <joint_name>base_left_front_wheel_joint</joint_name>
            <joint_name>base_right_front_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- Ground Truth Odometry Publisher Plugin for Validation -->
    <gazebo>
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>/model/my_robot/odometry</odom_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>2</dimensions>
        </plugin>
    </gazebo>

</robot>