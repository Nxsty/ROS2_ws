<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="base_left_back_wheel_link">
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

    <gazebo reference="base_right_back_wheel_link">
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

    <gazebo reference="base_left_front_wheel_link">
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

    <gazebo reference="base_right_front_wheel_link">
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>base_left_front_wheel_joint</joint_name>
            <topic>/base_left_front_wheel_joint/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>base_right_front_wheel_joint</joint_name>
            <topic>/base_right_front_wheel_joint/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>base_left_back_wheel_joint</joint_name>
            <topic>/base_left_back_wheel_joint/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>base_right_back_wheel_joint</joint_name>
            <topic>/base_right_back_wheel_joint/cmd_vel</topic>
        </plugin>
    </gazebo>
      



    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <robot_namespace>my_robot</robot_namespace>
            <model_name>my_robot</model_name>
            <joint_name>base_left_back_wheel_joint</joint_name>
            <joint_name>base_right_back_wheel_joint</joint_name>
            <joint_name>base_left_front_wheel_joint</joint_name>
            <joint_name>base_right_front_wheel_joint</joint_name>
        </plugin>
    </gazebo>
    
</robot>